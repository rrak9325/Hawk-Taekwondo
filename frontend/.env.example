# Frontend Environment Variables Example
# Copy this file to .env.production for production builds

# Backend API URL
# For production, set this to your backend URL
# Examples:
# - Same domain: https://hawktaekwondo.com
# - Subdomain: https://api.hawktaekwondo.com
# - Different domain: https://your-backend.com
VITE_API_URL=https://hawktaekwondo.com
